[user]
  name = Dmitry Gening
[status]
  short = true
  showStash = true
[push]
  default = current
[core]
  # commit-msg checks intent-first messages; other names chain to the repo's .git/hooks
  hooksPath = ~/.config/git/hooks
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  # n / N jump between files; light/dark is detected from the terminal
  navigate = true
  side-by-side = true
  line-numbers = true
[diff]
  colorMoved = default
  # git dft: structural diff that ignores reformatting
  tool = difftastic
[difftool]
  prompt = false
[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"
[pager]
  # difft output is not a unified diff, so keep it away from delta
  difftool = less -RF
[alias]
  dft = difftool
  dlog = -c diff.external=difft -c core.pager='less -RF' log -p --ext-diff
  dshow = -c diff.external=difft -c core.pager='less -RF' show --ext-diff
  commit-rnd = "!git commit -m \"`curl -s whatthecommit.com | awk '{ if ($0 ~ /<p>.*/) { sub(/<p>/, \"\", $0); print }}'`\""
  find-ancestor = "!zsh -c 'diff -u <(git rev-list --first-parent '${1:-master}') <(git rev-list --first-parent '${2:-HEAD}') | sed -ne \"s/^ //p\" | head -1' -"
  log-tree = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all
  change-commits = "!f() { VAR=$1; OLD=$2; NEW=$3; shift 3; git filter-branch --env-filter \"if [[ \\\"$`echo $VAR`\\\" = '$OLD' ]]; then export $VAR='$NEW'; fi\" $@; }; f "
[include]
  path = config.local
